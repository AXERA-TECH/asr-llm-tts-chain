+    f.seekg(0, std::ios::beg);
+    if (size <= 0)
+    {
+        ALOGE("model file(%s) empty", model_file);
+        return -1;
+    }
+    std::vector<char> model_buffer((size_t)size);
+    f.read(model_buffer.data(), size);
